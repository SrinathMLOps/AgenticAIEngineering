# ══════════════════════════════════════════════════════════════════
#  .env.template — Day 2: Transformer Internals + Prompt Anatomy
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════

# ── Google Gemini API (Required for Lessons 2, 3, 4, 5, 7) ───────
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Google ADK settings (Required for Lesson 8) ──────────────────
# ADK uses GEMINI_API_KEY above by default.
# Set GOOGLE_GENAI_USE_VERTEXAI=FALSE to use Gemini API (not Vertex AI).
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# ── (Optional) Vertex AI — only if using GCP instead of AI Studio ─
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ── (Optional) OpenAI API — used as fallback in Lesson 2 ─────────
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# ── Model Defaults ────────────────────────────────────────────────
# Which Gemini model to use in lessons (can override per-lesson)
DEFAULT_GEMINI_MODEL=gemini-2.0-flash

# ── Debug / Logging ───────────────────────────────────────────────
# Set to TRUE to enable verbose ADK event logging in Lesson 8
ADK_DEBUG=FALSE

# ══════════════════════════════════════════════════════════════════
#  HOW TO USE
# ══════════════════════════════════════════════════════════════════
#  PowerShell (Windows):
#    Copy-Item .env.template .env
#    # Then edit .env and fill in your keys
#
#  Load in Python:
#    pip install python-dotenv
#    from dotenv import load_dotenv; load_dotenv()
#    import os; key = os.environ["GEMINI_API_KEY"]
#
#  Or set per-session in PowerShell (no .env file needed):
#    $env:GEMINI_API_KEY = "your-key-here"
#    $env:GOOGLE_GENAI_USE_VERTEXAI = "FALSE"
# ══════════════════════════════════════════════════════════════════
